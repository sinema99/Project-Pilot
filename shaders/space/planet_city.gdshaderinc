group_uniforms City;
uniform bool city_on = true;
uniform vec3 city_color : source_color = vec3(0.64, 0.66, 0.7);
// Per-platform shade: each platform is one of three tones, city_color times 1 - this, 1 or 1 + this.
uniform float city_tile_shade : hint_range(0.0, 0.3) = 0.1;
// A raised block is this much lighter than city_color.
uniform float city_top_lift : hint_range(0.0, 0.5) = 0.2;
// The shaded side, inside the edges facing away from the relief light (platforms and blocks).
uniform vec3 city_lip_color : source_color = vec3(0.4, 0.42, 0.47);
// Unit sphere, as cloud_shadow_offset: the lip's width and how far the shadows land.
uniform float city_lip_width : hint_range(0.0, 0.02) = 0.004;
uniform float city_shadow_offset : hint_range(0.0, 0.05) = 0.008;
uniform float city_top_shadow_offset : hint_range(0.0, 0.05) = 0.004;
uniform float city_shadow_tone : hint_range(0.0, 1.0) = 0.66;
uniform vec3 city_rail_color : source_color = vec3(0.5, 0.52, 0.58);
// Rail width in grid degrees.
uniform float city_rail_deg : hint_range(0.0, 0.5) = 0.11;
// Rooftop blocks: a few pixels each from orbit. Block pitch in grid degrees, the street share of it,
// how much lighter streets are, and every Nth street is a wider boulevard.
uniform bool city_blocks_on = true;
uniform float city_block_deg : hint_range(0.02, 0.5) = 0.1;
uniform float city_street : hint_range(0.0, 0.5) = 0.22;
uniform float city_street_lift : hint_range(0.0, 0.5) = 0.1;
uniform float city_boulevard_every = 7.0;
// Blocks are one of four tones down to 1 - this; empty lots near a platform's edge show its base.
uniform float city_block_shade : hint_range(0.0, 0.4) = 0.16;
uniform float city_empty_edge : hint_range(0.0, 1.0) = 0.45;
// Platform cores are darker (denser) by this much.
uniform float city_core_dark : hint_range(0.0, 0.4) = 0.12;
// Districts (the squares between boulevards): each takes a tone shift up to this, and some have
// bigger blocks (2x or 3x the pitch).
uniform float city_district_shade : hint_range(0.0, 0.3) = 0.08;
// Breaking the grid. Share of street lines dropped inside a district (merging blocks into longer
// ones); share of platforms with a diagonal avenue; share of boulevard crossings that are
// roundabouts and their radius in blocks; share of districts with a flat plaza; share left open.
uniform float city_merge : hint_range(0.0, 0.8) = 0.25;
uniform float city_diagonal_share : hint_range(0.0, 1.0) = 0.5;
uniform float city_roundabout_share : hint_range(0.0, 1.0) = 0.2;
uniform float city_roundabout_blocks : hint_range(0.5, 4.0) = 1.5;
uniform float city_plaza_share : hint_range(0.0, 1.0) = 0.3;
uniform float city_open_share : hint_range(0.0, 1.0) = 0.06;
// Plazas and open districts: flat, this much lighter than the platform.
uniform float city_plaza_lift : hint_range(0.0, 0.3) = 0.06;
// Towers: their tops and the long thin shadow (unit sphere, as city_shadow_offset).
uniform vec3 city_tower_color : source_color = vec3(0.96, 0.97, 1.0);
uniform float city_tower_shadow : hint_range(0.0, 0.08) = 0.03;
// Shadow width as a multiple of the tower's.
uniform float city_tower_shadow_width : hint_range(0.5, 3.0) = 1.6;
// Unfinished outposts (revision 5): built core -> bare deck -> open girder frame, with snow drifts.
uniform bool outposts_on = true;
// Girder pitch and width (share of the pitch), grid degrees; girders are this much darker than the deck.
uniform float outpost_frame_deg : hint_range(0.1, 1.0) = 0.4;
uniform float outpost_girder : hint_range(0.05, 0.5) = 0.18;
uniform float outpost_girder_dark : hint_range(0.0, 0.5) = 0.12;
// Jitter of the built / bare / frame boundaries, in fade units, stepped per rooftop block.
uniform float outpost_ragged : hint_range(0.0, 0.3) = 0.08;
// Snow drifts on bare deck and frame: colour, patch size (grid degrees) and cover, which grows toward
// the frame end up to outpost_drift_cover * 1.5.
uniform vec3 outpost_drift_color : source_color = vec3(0.86, 0.9, 0.95);
uniform float outpost_drift_deg : hint_range(0.05, 2.0) = 0.35;
uniform float outpost_drift_cover : hint_range(0.0, 0.7) = 0.3;
group_uniforms;

// The grid space: degrees, longitude squeezed.
vec2 city_grid(vec2 ll) {
	return vec2(ll.y * cos(radians(CITY_MID_LAT)), ll.x);
}

vec2 city_at_grid(vec3 e) {
	return city_grid(earth_lat_lon(e));
}

bool city_in_rect(vec2 g, vec4 r) {
	return all(lessThanEqual(abs(g - r.xy), r.zw));
}

// Index of the platform under grid point g, or -1.
int city_platform(vec2 g) {
	for (int i = 0; i < CITY_PLATFORMS_COUNT; i++) {
		if (city_in_rect(g, CITY_PLATFORMS[i])) {
			return i;
		}
	}
	return -1;
}

bool city_top(vec2 g) {
	for (int i = 0; i < CITY_TOPS_COUNT; i++) {
		if (city_in_rect(g, CITY_TOPS[i])) {
			return true;
		}
	}
	return false;
}

bool city_rail(vec2 g) {
	float h = city_rail_deg * 0.5;
	for (int i = 0; i < CITY_RAILS_COUNT; i++) {
		vec4 s = CITY_RAILS[i];
		vec2 lo = min(s.xy, s.zw) - h;
		vec2 hi = max(s.xy, s.zw) + h;
		if (all(greaterThanEqual(g, lo)) && all(lessThanEqual(g, hi))) {
			return true;
		}
	}
	if (outposts_on) {
		for (int i = 0; i < OUTPOST_RAILS_COUNT; i++) {
			vec4 s = OUTPOST_RAILS[i];
			vec2 lo = min(s.xy, s.zw) - h;
			vec2 hi = max(s.xy, s.zw) + h;
			if (all(greaterThanEqual(g, lo)) && all(lessThanEqual(g, hi))) {
				return true;
			}
		}
	}
	return false;
}

bool city_tower(vec2 g) {
	for (int i = 0; i < CITY_TOWERS_COUNT; i++) {
		if (city_in_rect(g, CITY_TOWERS[i])) {
			return true;
		}
	}
	return false;
}

// Does tower t shade grid point g? Within its width of the segment g -> sun.
bool city_tower_shades(vec4 t, vec2 g, vec2 d, float len2) {
	float s = clamp(dot(t.xy - g, d) / len2, 0.0, 1.0);
	return s > 0.0 && length(t.xy - (g + d * s)) < t.z * city_tower_shadow_width;
}

// Is grid point g in a tower's long shadow (the mega city's or an outpost's)? `sun` is the grid point
// city_tower_shadow along the surface toward the relief light: a tower between the two shades g.
bool city_tower_shade(vec2 g, vec2 sun) {
	vec2 d = sun - g;
	float len2 = max(dot(d, d), 1e-8);
	for (int i = 0; i < CITY_TOWERS_COUNT; i++) {
		if (city_tower_shades(CITY_TOWERS[i], g, d, len2)) {
			return true;
		}
	}
	if (outposts_on) {
		for (int i = 0; i < OUTPOST_TOWERS_COUNT; i++) {
			if (city_tower_shades(OUTPOST_TOWERS[i], g, d, len2)) {
				return true;
			}
		}
	}
	return false;
}

// Is the street line on the low side of cell k (along one axis) of a district kept? Dropped lines
// merge neighbouring blocks.
bool city_street_kept(vec2 district, float k, float axis) {
	return space_hash(vec3(district * 3.1 + axis * 17.0, k)) >= city_merge;
}

// Rooftop blocks over a platform's (or raised block's) base colour, laid out like a real city on
// the shared axis: boulevards every Nth street, roundabouts at some crossings, a diagonal avenue
// through some platforms, and districts between the boulevards, each with its own tone, block size
// (1x, 2x or 3x), merged blocks, and maybe a flat plaza; a few are left open. Blocks take four
// tones, empty lots thin out toward the edge and the core is darker.
vec3 city_roof(vec2 g, vec4 r, vec3 base) {
	if (!city_blocks_on) {
		return base;
	}
	vec3 road = base * (1.0 + city_street_lift);
	vec3 plaza = base * (1.0 + city_plaza_lift);
	vec2 c = g / city_block_deg;
	float every = city_boulevard_every;

	// Roundabouts: a ring road around a darker island at some boulevard crossings.
	vec2 cross_ = round(c / every) * every;
	float rd = length(c - cross_);
	if (space_hash(vec3(cross_, 5.5)) < city_roundabout_share && rd < city_roundabout_blocks) {
		return rd < city_roundabout_blocks * 0.5 ? base * (1.0 - city_block_shade * 0.6) : road;
	}

	// Boulevards.
	vec2 f = fract(c);
	vec2 on_boulevard = vec2(lessThan(f, vec2(city_street * 2.5)))
			* vec2(equal(mod(floor(c), vec2(every)), vec2(0.0)));
	if (on_boulevard.x + on_boulevard.y > 0.0) {
		return road;
	}

	// A diagonal avenue through some platforms, 25-55 deg off the axis, near the middle.
	float ph = space_hash(vec3(r.xy * 3.7, 3.3));
	if (ph < city_diagonal_share) {
		float ang = radians(mix(25.0, 55.0, space_hash(vec3(r.xy, 7.1)))) * (ph < city_diagonal_share * 0.5 ? 1.0 : -1.0);
		vec2 n = vec2(-sin(ang), cos(ang));
		float off = (space_hash(vec3(r.xy, 9.4)) - 0.5) * r.w;
		if (abs(dot(g - r.xy, n) - off) < city_block_deg * city_street * 2.0) {
			return road;
		}
	}

	// Districts: open, plaza, then blocks.
	vec2 district = floor(c / every);
	vec2 local = c - district * every;
	float dh = space_hash(vec3(district, 6.3));
	if (space_hash(vec3(district, 2.2)) < city_open_share) {
		return plaza;
	}
	if (space_hash(vec3(district, 4.4)) < city_plaza_share) {
		vec2 size = floor(vec2(space_hash(vec3(district, 1.1)), space_hash(vec3(district, 1.3))) * 2.0) + 2.0;
		vec2 at = 1.0 + floor(vec2(space_hash(vec3(district, 2.7)), space_hash(vec3(district, 3.9)))
				* (every - 1.0 - size));
		vec2 pq = local - at;
		if (all(greaterThanEqual(pq, vec2(0.0))) && all(lessThan(pq, size))) {
			// Some plazas keep a small monument block in the middle.
			bool monument = space_hash(vec3(district, 8.8)) < 0.5 && length(pq - size * 0.5) < 0.35;
			return monument ? base * (1.0 - city_block_shade) : plaza;
		}
	}
	float size = dh < 0.7 ? 1.0 : (dh < 0.95 ? 2.0 : 3.0);
	vec2 cs = local / size;
	vec2 id = floor(cs);
	vec2 fs = fract(cs);
	float sw = city_street / size;
	if ((fs.x < sw && city_street_kept(district, id.x, 0.0))
			|| (fs.y < sw && city_street_kept(district, id.y, 1.0))) {
		return road;
	}
	// The merged block's id: step back over dropped street lines.
	for (int k = 0; k < 4; k++) {
		if (id.x <= 0.0 || city_street_kept(district, id.x, 0.0)) {
			break;
		}
		id.x -= 1.0;
	}
	for (int k = 0; k < 4; k++) {
		if (id.y <= 0.0 || city_street_kept(district, id.y, 1.0)) {
			break;
		}
		id.y -= 1.0;
	}
	id += district * 64.0;
	// 0 at the platform's centre, 1 at its edge.
	vec2 q = abs(g - r.xy) / r.zw;
	float edge = max(q.x, q.y);
	if (space_hash(vec3(id, 4.1 + size)) < city_empty_edge * edge * edge) {
		return base;
	}
	float tone = floor(space_hash(vec3(id, 8.7 + size)) * 4.0) / 3.0;
	float dshade = 1.0 + (space_hash(vec3(district, 1.9)) * 2.0 - 1.0) * city_district_shade;
	return base * dshade * (1.0 - city_block_shade * tone) * (1.0 - city_core_dark * (1.0 - edge));
}

// Unfinished outposts (revision 5). Index of the outpost platform under grid point g, or -1.
int outpost_at(vec2 g) {
	if (!outposts_on) {
		return -1;
	}
	for (int i = 0; i < OUTPOST_PLATFORMS_COUNT; i++) {
		if (city_in_rect(g, OUTPOST_PLATFORMS[i])) {
			return i;
		}
	}
	return -1;
}

// Where g sits along outpost i's fade, 0 at the built end and 1 at the frame end, taken at the centre
// of g's cell on a grid of `pitch` laid from the platform's corner (so boundaries step on that grid),
// jittered per cell.
float outpost_fade(vec2 g, int i, float pitch) {
	vec4 r = OUTPOST_PLATFORMS[i];
	vec4 f = OUTPOST_FADE[i];
	vec2 corner = r.xy - r.zw;
	vec2 cell = floor((g - corner) / pitch);
	vec2 q = (corner + (cell + 0.5) * pitch - r.xy) / r.zw;
	float t = f.x == 0.0 && f.y == 0.0 ? max(abs(q.x), abs(q.y)) : (dot(q, f.xy) + 1.0) * 0.5;
	return t + (space_hash(vec3(cell + r.xy * 5.3, 12.7 + pitch)) - 0.5) * 2.0 * outpost_ragged;
}

// 0 built core, 1 bare deck, 2 open frame. The built edge steps on the rooftop blocks, the deck's edge
// on the girders.
int outpost_stage(vec2 g, int i) {
	vec4 f = OUTPOST_FADE[i];
	if (outpost_fade(g, i, outpost_frame_deg) >= f.w) {
		return 2;
	}
	return outpost_fade(g, i, city_block_deg) < f.z ? 0 : 1;
}

// Is g on one of outpost i's girders (the grid, or the platform's rim)?
bool outpost_girder_at(vec2 g, int i) {
	vec4 r = OUTPOST_PLATFORMS[i];
	float w = outpost_girder * outpost_frame_deg;
	vec2 f = fract((g - (r.xy - r.zw)) / outpost_frame_deg);
	return any(lessThan(f, vec2(outpost_girder))) || any(greaterThan(abs(g - r.xy), r.zw - w));
}

bool outpost_solid(vec2 g) {
	int i = outpost_at(g);
	return i >= 0 && (outpost_stage(g, i) < 2 || outpost_girder_at(g, i));
}

bool outpost_tower(vec2 g) {
	for (int i = 0; i < OUTPOST_TOWERS_COUNT; i++) {
		if (city_in_rect(g, OUTPOST_TOWERS[i])) {
			return true;
		}
	}
	return false;
}

// An outpost's colour at grid point g; false off it or in an open frame cell (snow shows through).
bool outpost_surface(vec2 g, vec3 e, vec3 toward, out vec3 col) {
	col = vec3(0.0);
	int i = outpost_at(g);
	if (i < 0) {
		return false;
	}
	vec4 r = OUTPOST_PLATFORMS[i];
	int stage = outpost_stage(g, i);
	float pick = floor(space_hash(vec3(r.xy * 7.13, 2.9)) * 3.0) - 1.0;
	vec3 base = city_color * (1.0 + pick * city_tile_shade);
	if (stage == 2) {
		if (!outpost_girder_at(g, i)) {
			return false;
		}
		col = base * (1.0 - outpost_girder_dark);
	} else {
		if (outpost_tower(g)) {
			col = city_tower_color;
			return true;
		}
		// The deck's lip, on the platform's outer edge only (the frame is level with the deck).
		vec2 back = city_at_grid(normalize(e - toward * city_lip_width));
		if (!city_in_rect(back, r)) {
			col = city_lip_color;
			return true;
		}
		col = stage == 0 ? city_roof(g, r, base) : base;
	}
	// Snow drifts on the deck and the frame, more toward the frame end.
	if (stage > 0) {
		float t = clamp(outpost_fade(g, i, city_block_deg), 0.0, 1.0);
		float n = space_fbm(vec3(g / outpost_drift_deg, 3.7), 3);
		if (n > 0.72 - outpost_drift_cover * (0.5 + t) * 0.5) {
			col = outpost_drift_color;
		}
	}
	if (city_tower_shade(g, city_at_grid(normalize(e + toward * city_tower_shadow)))) {
		col *= city_shadow_tone;
	}
	return true;
}

// The city's colour at Earth direction `e`, with `found` false off the city. `toward` is the unit
// tangent toward the relief light (earth_toward). Rails count as city but take no lip.
vec3 city_surface(vec3 e, vec3 toward, out bool found) {
	found = false;
	if (!city_on) {
		return vec3(0.0);
	}
	vec2 g = city_at_grid(e);
	int p = city_platform(g);
	if (p < 0) {
		vec3 oc;
		if (outpost_surface(g, e, toward, oc)) {
			found = true;
			return oc;
		}
		found = city_rail(g);
		return city_rail_color;
	}
	found = true;
	if (city_tower(g)) {
		return city_tower_color;
	}
	vec2 back = city_at_grid(normalize(e - toward * city_lip_width));
	vec2 sun = city_at_grid(normalize(e + toward * city_tower_shadow));
	vec3 col;
	if (city_top(g)) {
		if (!city_top(back)) {
			return city_lip_color;
		}
		col = city_roof(g, CITY_PLATFORMS[p], city_color * (1.0 + city_top_lift));
	} else {
		if (city_platform(back) < 0) {
			return city_lip_color;
		}
		float pick = floor(space_hash(vec3(CITY_PLATFORMS[p].xy * 7.13, 2.9)) * 3.0) - 1.0;
		col = city_roof(g, CITY_PLATFORMS[p], city_color * (1.0 + pick * city_tile_shade));
		// A raised block's short shadow on the platform under it.
		if (city_top(city_at_grid(normalize(e + toward * city_top_shadow_offset)))) {
			col *= city_shadow_tone;
		}
	}
	if (city_tower_shade(g, sun)) {
		col *= city_shadow_tone;
	}
	return col;
}

// Does a platform or tower shade the ground at `e`? Shadows land away from the relief light.
bool city_shadow_at(vec3 e, vec3 toward) {
	if (!city_on) {
		return false;
	}
	vec2 g = city_at_grid(e);
	vec2 s = city_at_grid(normalize(e + toward * city_shadow_offset));
	return city_platform(s) >= 0 || outpost_solid(s)
			|| city_tower_shade(g, city_at_grid(normalize(e + toward * city_tower_shadow)));
}
