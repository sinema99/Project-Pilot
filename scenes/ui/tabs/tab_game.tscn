[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/tabs/tab_game.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/menu_row.gd" id="2"]

[node name="TabGame" type="VBoxContainer"]
