[rendering]

lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/directional_shadow/16_bits=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.15, 0.17, 0.2, 1)
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

diffuse_curve={
"type": "sampler2D",
"value": "res://resources/cel_diffuse_curve.tres"
}
specular_smoothness={
"type": "float",
"value": 0.05
}
fresnel_smoothness={
"type": "float",
"value": 0.05
}
outline_width={
"type": "float",
"value": 4.0
}
outline_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
