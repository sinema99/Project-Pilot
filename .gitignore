# Godot 4+ editor cache / imported assets (regenerated on open)
.godot/

# Godot export output
/build/
/export/
*.exe
*.pck

# In-game debug screenshots (M key) - keep the folder, not the shots
/screenshots/*
!/screenshots/.gitkeep

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*~

# Agent skills installed by `npx skills add` (local, not shared)
.agents/
.claude/
skills-lock.json
